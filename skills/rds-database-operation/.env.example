# 阿里云 RDS 环境变量配置示例
# 在 OpenClaw 环境变量中配置以下参数（不是操作系统环境变量）

# AccessKey 配置（必填）
ALIBABA_CLOUD_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
ALIBABA_CLOUD_ACCESS_KEY_SECRET=YOUR_ACCESS_KEY_SECRET

# 地域配置（可选，默认 cn-hangzhou）
ALIBABA_CLOUD_REGION_ID=cn-hangzhou

# 配置方式：
# 1. 在 OpenClaw Gateway 配置中添加
# 2. 或在会话环境变量中设置

# 获取 AccessKey 的方法：
# 1. 登录阿里云控制台
# 2. 访问 RAM 访问控制
# 3. 创建 RAM 用户并获取 AccessKey
# 4. 为 RAM 用户授予 RDS 相关权限

# ⚠️ 安全提醒：
# - 不要在代码中硬编码 AKSK
# - 建议使用 RAM 子账号的 AccessKey
# - 定期轮换 AccessKey
# - 不要将此文件提交到版本控制
