# 阿里云凭证配置
ALIBABA_CLOUD_ACCESS_KEY_ID=your-access-key-id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your-access-key-secret
ALIBABA_CLOUD_REGION=cn-hangzhou

# BaaS 数据库账号配置（用于接管模式连接现有实例）
# RDS/PolarDB 账号
BAAS_RDS_ACCOUNT=admin
BAAS_RDS_PASSWORD=your-rds-password

# Redis 账号（如有）
BAAS_REDIS_ACCOUNT=your-redis-account
BAAS_REDIS_PASSWORD=your-redis-password

# MongoDB 账号
BAAS_MONGODB_ACCOUNT=root
BAAS_MONGODB_PASSWORD=your-mongodb-password

# ADB MySQL 账号
BAAS_ADB_ACCOUNT=admin
BAAS_ADB_PASSWORD=your-adb-password
