# 阿里云 DAS 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# 阿里云访问凭据（必需）
ALIBABA_CLOUD_ACCESS_KEY_ID="your_access_key_id"
ALIBABA_CLOUD_ACCESS_KEY_SECRET="your_access_key_secret"

# 可选：DAS Agent ID
# ALIBABA_CLOUD_DAS_AGENT_ID="your_agent_id"

# 可选：STS Token（如使用临时凭据）
# ALIBABA_CLOUD_SECURITY_TOKEN="your_security_token"

# 可选：禁用 ECS 元数据（本地开发时建议设置）
ALIBABA_CLOUD_ECS_METADATA_DISABLED="true"
